" Map <leader>pr to run ./qemu.sh in split
nnoremap <leader>pr :!./qemu.sh<CR>
" Map <leader>pl to run ./lsp-clean.sh
nnoremap <leader>pl :!./lsp-clean.sh<CR>
" Map <leader>pc to run ./clean.sh
nnoremap <leader>pc :!./clean.sh<CR>
" Map <leader>pb to run ./bear.sh
nnoremap <leader>pb :!./bear.sh<CR>
" Map <leader>lr to run :LspRestart
nnoremap <leader>lr :LspRestart<CR>
